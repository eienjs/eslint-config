{
  "name": "@eienjs/eslint-config",
  "type": "module",
  "version": "2.0.1",
  "packageManager": "pnpm@11.9.0",
  "description": "EienJS ESLint Config",
  "author": "Fernando Isidro <luffynando@gmail.com> (https://github.com/luffynando/)",
  "license": "MIT",
  "homepage": "https://github.com/eienjs/eslint-config",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eienjs/eslint-config.git"
  },
  "bugs": {
    "url": "https://github.com/eienjs/eslint-config/issues"
  },
  "keywords": [
    "eslint-config",
    "adonisjs",
    "astro"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./cli": "./dist/cli.mjs",
    "./configs": "./dist/configs.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.mts",
  "bin": "./bin/index.mjs",
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "husky",
    "prebuild": "pnpm tool:code",
    "build": "pnpm gen && tsdown",
    "commitlint": "commitlint --edit",
    "stub": "tsdown",
    "dev": "npx @eslint/config-inspector --config eslint.config.ts",
    "build:inspector": "pnpm build && npx @eslint/config-inspector build --config eslint.config.ts --out-dir ./.eslint-config-inspector",
    "watch": "tsdown --watch",
    "gen": "tsx scripts/typegen.ts && tsx scripts/versiongen.ts",
    "changelog": "auto-changelog -u -p",
    "release": "release-it",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "typecheck": "tsc --noEmit",
    "tool:code": "pnpm lint:check && pnpm typecheck"
  },
  "peerDependencies": {
    "@adonisjs/eslint-plugin": "^2.2.2",
    "@nuxt/eslint-plugin": "^1.16.0",
    "@prettier/plugin-xml": "^3.4.2",
    "astro-eslint-parser": "^2.0.0",
    "eslint": "^10.5.0",
    "eslint-plugin-astro": "^2.0.0",
    "eslint-plugin-erasable-syntax-only": "^0.4.2",
    "eslint-plugin-format": "^2.0.1",
    "prettier-plugin-astro": "^0.14.1"
  },
  "peerDependenciesMeta": {
    "@adonisjs/eslint-plugin": {
      "optional": true
    },
    "@nuxt/eslint-plugin": {
      "optional": true
    },
    "@prettier/plugin-xml": {
      "optional": true
    },
    "astro-eslint-parser": {
      "optional": true
    },
    "eslint-plugin-astro": {
      "optional": true
    },
    "eslint-plugin-erasable-syntax-only": {
      "optional": true
    },
    "eslint-plugin-format": {
      "optional": true
    },
    "prettier-plugin-astro": {
      "optional": true
    }
  },
  "dependencies": {
    "@antfu/install-pkg": "catalog:prod",
    "@clack/prompts": "catalog:prod",
    "@e18e/eslint-plugin": "catalog:prod",
    "@eslint-community/eslint-plugin-eslint-comments": "catalog:prod",
    "@eslint/markdown": "catalog:prod",
    "@stylistic/eslint-plugin": "catalog:prod",
    "@typescript-eslint/eslint-plugin": "catalog:prod",
    "@typescript-eslint/parser": "catalog:prod",
    "@vitest/eslint-plugin": "catalog:prod",
    "ansis": "catalog:prod",
    "cac": "catalog:prod",
    "eslint-config-flat-gitignore": "catalog:prod",
    "eslint-flat-config-utils": "catalog:prod",
    "eslint-merge-processors": "catalog:prod",
    "eslint-plugin-antfu": "catalog:prod",
    "eslint-plugin-command": "catalog:prod",
    "eslint-plugin-import-lite": "catalog:prod",
    "eslint-plugin-jsdoc": "catalog:prod",
    "eslint-plugin-jsonc": "catalog:prod",
    "eslint-plugin-n": "catalog:prod",
    "eslint-plugin-no-only-tests": "catalog:prod",
    "eslint-plugin-perfectionist": "catalog:prod",
    "eslint-plugin-pnpm": "catalog:prod",
    "eslint-plugin-regexp": "catalog:prod",
    "eslint-plugin-toml": "catalog:prod",
    "eslint-plugin-unicorn": "catalog:prod",
    "eslint-plugin-unused-imports": "catalog:prod",
    "eslint-plugin-vue": "catalog:prod",
    "eslint-plugin-yml": "catalog:prod",
    "eslint-processor-vue-blocks": "catalog:prod",
    "globals": "catalog:prod",
    "local-pkg": "catalog:prod",
    "parse-gitignore": "catalog:prod",
    "pathe": "catalog:prod",
    "toml-eslint-parser": "catalog:prod",
    "vue-eslint-parser": "catalog:prod",
    "yaml-eslint-parser": "catalog:prod"
  },
  "devDependencies": {
    "@adonisjs/eslint-plugin": "catalog:peer",
    "@commitlint/cli": "catalog:dev",
    "@commitlint/config-conventional": "catalog:dev",
    "@eslint/config-inspector": "catalog:dev",
    "@nuxt/eslint-plugin": "catalog:peer",
    "@prettier/plugin-xml": "catalog:peer",
    "@types/node": "catalog:dev",
    "astro-eslint-parser": "catalog:peer",
    "auto-changelog": "catalog:dev",
    "baseline-browser-mapping": "catalog:dev",
    "eslint": "catalog:peer",
    "eslint-plugin-astro": "catalog:peer",
    "eslint-plugin-erasable-syntax-only": "catalog:peer",
    "eslint-plugin-format": "catalog:peer",
    "eslint-typegen": "catalog:dev",
    "find-up-simple": "catalog:inline",
    "husky": "catalog:dev",
    "pnpm-workspace-yaml": "catalog:dev",
    "prettier-plugin-astro": "catalog:peer",
    "release-it": "catalog:dev",
    "tsdown": "catalog:dev",
    "tsdown-stale-guard": "catalog:dev",
    "tsx": "catalog:dev",
    "typescript": "catalog:dev"
  },
  "inlinedDependencies": {
    "find-up-simple": "1.0.1"
  },
  "resolutions": {
    "@eslint-community/eslint-utils": "catalog:peer",
    "@typescript-eslint/types": "catalog:peer",
    "@typescript-eslint/utils": "catalog:peer",
    "eslint": "catalog:peer",
    "tsx": "catalog:dev"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "auto-changelog": {
    "template": "keepachangelog",
    "hideCredit": true,
    "commitLimit": false
  },
  "release-it": {
    "git": {
      "commit": true,
      "tag": true,
      "push": true,
      "requireCleanWorkingDir": true,
      "commitMessage": "chore(release): :tada: v${version}",
      "tagAnnotation": "chore(release): :tada: v${version}"
    },
    "github": {
      "release": true,
      "releaseName": "Release v${version}"
    },
    "npm": {
      "publish": true,
      "publishPackageManager": "pnpm",
      "publishArgs": [
        "--no-git-checks"
      ]
    },
    "hooks": {
      "before:init": [
        "pnpm run lint:check",
        "pnpm run typecheck"
      ],
      "after:bump": [
        "pnpm run build",
        "pnpm run changelog"
      ]
    }
  }
}
